# 统一换行：仓库用 LF，Windows 脚本保持 CRLF
* text=auto eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.wav           binary
*.exe           binary
*.bin           binary

# 让 GitHub 认出 Arduino sketch 的语法
*.ino           linguist-language=C++
